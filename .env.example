# Supabase Configuration (required for production)
# Copy this file to .env.local and fill in your Supabase project credentials
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Demo auth (NEVER enable with real PHI)
# Production builds fail closed without Supabase unless this is true.
# E2E sets this automatically. Local `vite build` demos may set it explicitly.
# VITE_ALLOW_DEMO_AUTH=true

# Disable MFA role enforcement (local UAT / E2E only — never in real deployments).
# Admin + doctor demo roles require MFA unless this is true. Restart Vite after changing.
# VITE_DISABLE_MFA=true

# Show vite-plugin-checker browser overlay (off by default — overlay blocks clicks in UAT).
# Diagnostics still print in the terminal. Opt in only when debugging lint/TS in the browser.
# VITE_CHECKER_OVERLAY=true

# Error Reporting (optional)
# VITE_ERROR_ENDPOINT=https://your-error-endpoint.com/api/errors

# Web Vitals reporting (optional — sendBeacon JSON payload)
# VITE_VITALS_ENDPOINT=https://your-metrics-endpoint.com/api/vitals

# ── Payments (Phase C1) ─────────────────────────────────────
# mock = in-app confirm (default for demo/E2E). stripe = Checkout via Edge Function.
# VITE_PAYMENT_PROVIDER=mock
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Push Notifications (optional)
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Medical file encryption ─────────────────────────────────
# Default: encrypt/decrypt via Edge Function `medical-files`
# (secret ENCRYPTION_KEY is set in Supabase Dashboard → Edge Functions → Secrets).
# Set to "false" only for emergency client-side fallback.
# VITE_USE_SERVER_ENCRYPTION=true

# Allow falling back to browser AES if the Edge Function is unavailable
# (requires VITE_ENCRYPTION_KEY). Do NOT enable with real PHI.
# VITE_ALLOW_CLIENT_ENCRYPTION=false

# Client-only encryption passphrase (legacy / emergency fallback only)
# Min 32 characters. Never use the anon key.
# VITE_ENCRYPTION_KEY=your-strong-encryption-passphrase-here-min-32-chars

# ── SSO (Phase D automation) ────────────────────────────────
# When set AND Supabase Auth provider is enabled in Dashboard,
# Login "Continue with SSO" calls signInWithOAuth instead of the stub.
# Values: azure | google | github | okta
# VITE_SSO_PROVIDER=azure

# ── SSO (Phase D automation) ────────────────────────────────
# When set AND Supabase Auth provider is enabled in Dashboard,
# Login "Continue with SSO" uses real OAuth instead of the stub.
# Values: azure | google | github | okta (okta maps to azure OIDC app)
# VITE_SSO_PROVIDER=azure
